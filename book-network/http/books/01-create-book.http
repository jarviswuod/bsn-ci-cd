### All four fields missing at once — confirm all 4 error codes surface, not just the first
# @name createAllFieldsMissing
POST {{baseUrl}}/books
Authorization: Bearer {{token_user1}}
Content-Type: application/json

{
  "title": "",
  "authorName": "",
  "isbn": "",
  "synopsis": "",
  "shareable": true
}

> {%
    client.test("All-empty payload rejected with 400", function() {
        client.assert(response.status === 400, "Expected 400, got " + response.status);
        client.log("Body: " + JSON.stringify(response.body));
        // Manually confirm the error body lists all 4 codes (100/101/102/103), not just one.
    });
%}

### shareable omitted entirely — primitive boolean should default to false, not error
# @name createShareableOmitted
POST {{baseUrl}}/books
Authorization: Bearer {{token_user1}}
Content-Type: application/json

{
  "title": "Shareable Omitted Book",
  "authorName": "Someone",
  "isbn": "116",
  "synopsis": "test"
}

> {%
    client.test("Omitted shareable defaults without error", function() {
        client.assert(response.status === 200, "Expected 200, got " + response.status);
    });
    client.global.set("shareableOmittedBook_id", response.body);
%}

### Duplicate isbn — no @Column(unique) on isbn in the entity, so this should succeed. Documents the gap.
# @name createDuplicateIsbn
POST {{baseUrl}}/books
Authorization: Bearer {{token_user1}}
Content-Type: application/json

{
  "title": "Duplicate ISBN Book",
  "authorName": "Someone",
  "isbn": "978-0132350884",
  "synopsis": "Same ISBN as Book1 on purpose.",
  "shareable": true
}

> {%
    client.test("TIGHTEN ME: duplicate isbn currently allowed — flag if you add a unique constraint", function() {
        client.log("Status: " + response.status + " body: " + JSON.stringify(response.body));
    });
%}

### BUG CHECK — client-supplied id matching an existing book. JPA save() on an entity
### with an existing id performs an UPDATE, not an INSERT. Confirm afterwards with 02-get-book-by-id.http.
# @name createWithExistingId
POST {{baseUrl}}/books
Authorization: Bearer {{token_user1}}
Content-Type: application/json

{
  "id": {{book1_id}},
  "title": "OVERWRITTEN TITLE",
  "authorName": "Robert C. Martin",
  "isbn": "978-0132350884",
  "synopsis": "Overwrite test.",
  "shareable": true
}

> {%
    client.test("BUG CHECK: create with existing id — inspect whether Book1 got overwritten", function() {
        client.assert(response.status === 200, "Expected 200, got " + response.status);
        client.assert(response.body === client.global.get("book1_id"), "Expected returned id to equal book1_id (confirms it updated, not inserted)");
    });
%}

### Verify the overwrite actually happened — run right after the request above
# @name verifyOverwrite
GET {{baseUrl}}/books/{{book1_id}}
Authorization: Bearer {{token_user1}}

> {%
    client.test("BUG CHECK: Book1 title should now read OVERWRITTEN TITLE if the app is vulnerable to id-spoofing on create", function() {
        client.assert(response.status === 200, "Expected 200, got " + response.status);
        client.log("Book1 title is now: " + response.body.title);
        // If this prints "OVERWRITTEN TITLE", any authenticated user could overwrite
        // ANY book by guessing/enumerating its id on POST /books — worth a fix.
    });
%}

### Very long synopsis (10k chars) — confirm no silent truncation or 500 from column length
# @name createLongSynopsis
POST {{baseUrl}}/books
Authorization: Bearer {{token_user1}}
Content-Type: application/json

{
  "title": "Long Synopsis Book",
  "authorName": "Someone",
  "isbn": "117",
  "synopsis": "{{$random.alphabetic(10000)}}",
  "shareable": true
}

> {%
    client.test("Long synopsis handled without server error", function() {
        client.assert(response.status === 200 || response.status === 400, "Expected 200 or 400, got " + response.status + " (500 = unhandled column-length issue)");
    });
%}
