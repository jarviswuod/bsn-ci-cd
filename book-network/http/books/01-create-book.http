### ==========================================================
### 01 — POST /books (create)
### Requires: 00-setup.http already run (token_user1, book1_id)
### ==========================================================

@baseUrl = http://localhost:8080/api/v1

### Happy path — extra book beyond the setup 9, to confirm create still works in isolation
# @name createHappyPath
POST {{baseUrl}}/books
Authorization: Bearer {{token_user1}}
Content-Type: application/json

{
  "title": "Test Driven Development",
  "authorName": "Kent Beck",
  "isbn": "978-0321146533",
  "synopsis": "By example.",
  "shareable": true
}

> {%
    client.test("Create book happy path returns 200 + numeric id", function() {
        client.assert(response.status === 200, "Expected 200, got " + response.status);
        client.assert(typeof response.body === "number", "Expected response body to be a numeric id, got " + typeof response.body);
    });
    client.global.set("tddBook_id", response.body);
%}

### No Authorization header at all
# @name createNoAuth
POST {{baseUrl}}/books
Content-Type: application/json

{
  "title": "No Auth Book",
  "authorName": "Nobody",
  "isbn": "000",
  "synopsis": "test",
  "shareable": true
}

> {%
    client.test("Create without auth is rejected", function() {
        client.assert(response.status === 403, "Expected 403, got " + response.status);
    });
%}

### Garbage/expired token
# @name createBadToken
POST {{baseUrl}}/books
Authorization: Bearer this.is.not.a.real.jwt
Content-Type: application/json

{
  "title": "Bad Token Book",
  "authorName": "Nobody",
  "isbn": "000",
  "synopsis": "test",
  "shareable": true
}

> {%
    client.test("Create with malformed token is rejected", function() {
        client.assert(response.status === 401 || response.status === 403, "Expected 401 or 403, got " + response.status);
    });
%}

### Missing title (empty string)
# @name createMissingTitle
POST {{baseUrl}}/books
Authorization: Bearer {{token_user1}}
Content-Type: application/json

{
  "title": "",
  "authorName": "Someone",
  "isbn": "111",
  "synopsis": "test",
  "shareable": true
}

> {%
    client.test("Empty title rejected with 400", function() {
        client.assert(response.status === 400, "Expected 400, got " + response.status);
    });
%}

### title field entirely absent from JSON (not just empty)
# @name createNullTitle
POST {{baseUrl}}/books
Authorization: Bearer {{token_user1}}
Content-Type: application/json

{
  "authorName": "Someone",
  "isbn": "112",
  "synopsis": "test",
  "shareable": true
}

> {%
    client.test("Missing title field rejected with 400", function() {
        client.assert(response.status === 400, "Expected 400, got " + response.status);
    });
%}

### Whitespace-only title — EDGE CASE: @NotEmpty does not trim, so " " may pass validation
# @name createWhitespaceTitle
POST {{baseUrl}}/books
Authorization: Bearer {{token_user1}}
Content-Type: application/json

{
  "title": "   ",
  "authorName": "Someone",
  "isbn": "113",
  "synopsis": "test",
  "shareable": true
}

> {%
    client.test("TIGHTEN ME: whitespace-only title — currently likely accepted (bean validation gap)", function() {
        client.log("Status: " + response.status + " body: " + JSON.stringify(response.body));
        // No hard assert here on purpose — this documents a validation gap.
        // If you add @NotBlank instead of @NotEmpty, flip this to assert 400.
    });
%}

