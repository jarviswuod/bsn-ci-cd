  "shareable": false
}

> {%
    client.test("Book3 created (non-shareable)", function() {
        client.assert(response.status === 200, "Expected 200, got " + response.status);
    });
    client.global.set("book3_id", response.body);
%}
// Book3 is deliberately non-shareable — used to test borrow rejection later.


