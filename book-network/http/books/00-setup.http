### --- User1's books: Book1, Book2 (shareable), Book3 (NOT shareable) ---

# @name createBook1
POST {{baseUrl}}/books
Authorization: Bearer {{token_user1}}
Content-Type: application/json

{
  "title": "Clean Code",
  "authorName": "Robert C. Martin",
  "isbn": "978-0132350884",
  "synopsis": "A handbook of agile software craftsmanship.",
  "shareable": true
}

> {%
    client.test("Book1 created", function() {
        client.assert(response.status === 200, "Expected 200, got " + response.status);
    });
    client.global.set("book1_id", response.body);
%}

### 
