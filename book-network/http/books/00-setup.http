### ==========================================================
### 00 — SETUP: authenticate 3 users, create 9 books (3 each)
### RUN THIS FILE FIRST, TOP TO BOTTOM.
### Assumes /auth/register + /auth/activate-account already done.
### ==========================================================

@baseUrl = http://localhost:8080/api/v1

### Authenticate User1
# @name authUser1
POST {{baseUrl}}/auth/authenticate
Content-Type: application/json

{
  "email": "user1@email.ke",
  "password": "password123"
}

> {%
    client.test("User1 authenticated", function() {
        client.assert(response.status === 200, "Expected 200, got " + response.status);
        client.assert(!!response.body.token, "Expected a token in response body");
    });
    client.global.set("token_user1", response.body.token);
%}

