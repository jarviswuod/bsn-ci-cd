### Sanity check — dump all captured globals so you can eyeball them once
# @name sanityCheckDump
GET {{baseUrl}}/books/{{book1_id}}
Authorization: Bearer {{token_user1}}

> {%
    client.test("Setup sanity check", function() {
        client.assert(response.status === 200, "Setup failed — Book1 not retrievable. Check tokens/ids above.");
        client.log("token_user1=" + client.global.get("token_user1"));
        client.log("token_user2=" + client.global.get("token_user2"));
        client.log("token_user3=" + client.global.get("token_user3"));
        for (let i = 1; i <= 9; i++) {
            client.log("book" + i + "_id=" + client.global.get("book" + i + "_id"));
        }
    });
%}
